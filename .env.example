# Moneyball FPL configuration
# Copy this file to .env and edit as needed.
# The .env file is loaded automatically at startup (see utils/env.py).

# ── Database ──────────────────────────────────────────────────────────
# SQLite database URL (default: data/moneyball.db relative to project root).
# Use an absolute path if the app and `alembic` may run from different
# working directories (the app resolves its own default to an absolute path).
DATABASE_URL=sqlite:///data/moneyball.db

# Allow the app to create tables on startup via create_all() (bootstrap only).
# Set to false in environments that manage the schema with Alembic to prevent
# cold starts from silently drifting from the migration baseline.
DB_ALLOW_CREATE_ALL=true

# ── FPL API ───────────────────────────────────────────────────────────
# NOTE: There is intentionally NO default FPL team ID. The viewer's Team ID
# is runtime state (session state), set on the onboarding page after it is
# validated against the FPL API — see docs/onboarding.md.
FPL_API_BASE_URL=https://fantasy.premierleague.com/api
FPL_USER_AGENT=MoneyballFPL/1.0
FPL_API_TIMEOUT=30
FPL_API_MAX_RETRIES=3
FPL_API_BACKOFF_BASE=1.0
# NEVER enable in production: permits retrying API calls with TLS verification disabled.
FPL_API_ALLOW_INSECURE_SSL=false

# ── Data freshness ────────────────────────────────────────────────────
# FPL data is re-fetched when older than this many seconds (default 3600 = 1 hour).
DATA_STALENESS_SECONDS=3600

# ── Admin / write access ──────────────────────────────────────────────
# Optional. When set, mutating actions (result ingestion, validation cycle,
# persist-to-ledger comparisons, manual data refresh) require this token
# entered in the sidebar. Leave empty for single-owner (unrestricted) mode.
# On Streamlit Community Cloud set this in .streamlit/secrets.toml instead.
ADMIN_TOKEN=

# ── Logging ───────────────────────────────────────────────────────────
# Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Optional log file path (default: console only)
LOG_FILE=

# ── Conversational Assistant (LLM) ────────────────────────────────────
# Optional. When unset, the assistant runs in offline/demo mode using a
# deterministic local responder. To enable live answers:
#   LLM_API_KEY  — API key (set in .streamlit/secrets.toml on Streamlit Cloud)
#   LLM_PROVIDER — openai (default) | anthropic | mock
#   LLM_MODEL    — model name (e.g. gpt-4o-mini, claude-3-5-haiku-latest)
#   LLM_BASE_URL — optional provider endpoint override
LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
